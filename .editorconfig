# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C/C++/CUDA source files
[*.{c,h,cpp,hpp,cu,cuh}]
indent_size = 4

# CMake files
[CMakeLists.txt]
indent_size = 4

[*.cmake]
indent_size = 4

# YAML files (GitHub Actions, configs)
[*.{yml,yaml}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# Makefile (requires tabs)
[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

# Shell scripts
[*.sh]
indent_size = 4

# Python files
[*.py]
indent_size = 4

# reStructuredText
[*.rst]
indent_size = 3

# Git config files
[.git*]
indent_size = 4
