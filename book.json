{
  "title": "CUDA Kernel Academy",
  "description": "Systematic CUDA kernel engineering from SGEMM fundamentals to reusable kernels, advanced optimization, and inference components.",
  "language": "en",
  "gitbook": ">=3.2.0",
  "author": "LessUp",
  "links": {
    "sidebar": {
      "📦 GitHub Repository": "https://github.com/LessUp/cuda-kernel-academy",
      "🐛 Report an Issue": "https://github.com/LessUp/cuda-kernel-academy/issues",
      "💬 Discussions": "https://github.com/LessUp/cuda-kernel-academy/discussions"
    }
  },
  "plugins": [
    "-sharing",
    "-fontsettings",
    "-lunr",
    "-search",
    "theme-default",
    "search-plus",
    "github-buttons",
    "edit-link",
    "anchorjs",
    "prism",
    "copy-code-button",
    "alerts"
  ],
  "pluginsConfig": {
    "github-buttons": {
      "buttons": [
        {
          "user": "LessUp",
          "repo": "cuda-kernel-academy",
          "type": "star",
          "size": "small",
          "count": true
        },
        {
          "user": "LessUp",
          "repo": "cuda-kernel-academy",
          "type": "fork",
          "size": "small",
          "count": true
        }
      ]
    },
    "edit-link": {
      "base": "https://github.com/LessUp/cuda-kernel-academy/edit/master",
      "label": "✏️ Suggest an edit"
    },
    "anchorjs": {
      "selector": "h2, h3, h4",
      "placement": "left",
      "visible": "hover"
    },
    "prism": {
      "css": [
        "prismjs/themes/prism-tomorrow.css"
      ],
      "lang": {
        "c": "c",
        "cpp": "cpp",
        "cuda": "cuda",
        "python": "python",
        "bash": "bash",
        "shell": "shell",
        "json": "json",
        "yaml": "yaml",
        "cmake": "cmake"
      }
    },
    "search-plus": {
      "limit": 20,
      "teaser": 150
    }
  },
  "structure": {
    "readme": "README.md",
    "summary": "SUMMARY.md"
  }
}
