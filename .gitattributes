# Auto detect text files and perform LF normalization
* text=auto

# Source code files
*.cpp text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cu text eol=lf
*.cuh text eol=lf

# CMake files
CMakeLists.txt text eol=lf
*.cmake text eol=lf

# Shell scripts
*.sh text eol=lf

# Batch scripts (Windows)
*.bat text eol=crlf
*.cmd text eol=crlf

# Configuration files
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.toml text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf

# Python
*.py text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.lib binary
*.o binary
*.obj binary

# CUDA specific
*.ptx binary
*.cubin binary
*.fatbin binary

# Git
.gitattributes text eol=lf
.gitignore text eol=lf

# Linguist overrides for GitHub language statistics
*.cu linguist-language=CUDA
*.cuh linguist-language=CUDA
